{
  "name": "anilak",
  "version": "1.0.0",
  "private": true,
  "description": "Voice-first multilingual urban air quality assistant",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "python3 -m http.server 8433",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json && tsc -p tsconfig.strict.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/**/*.test.js\"",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  }
}
